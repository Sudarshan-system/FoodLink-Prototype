{
  "name": "foodlink",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:rules": "firebase emulators:exec --only firestore \"node tests/rules.test.mjs\"",
    "deploy": "npm run build && firebase deploy --only hosting",
    "deploy:preview": "npm run build && firebase hosting:channel:deploy preview",
    "deploy:all": "npm run build && firebase deploy --only firestore:rules,hosting"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.31.0",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "puppeteer": "^25.12.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
