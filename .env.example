# FoodLink Web Application Configuration
# Copy this file to .env.local and fill in the values for your live Firebase project.
# Command: cp .env.example .env.local

# -----------------------------------------------------------------------------
# FIREBASE WEB CONFIGURATION (REQUIRED FOR PRODUCTION BUILDS)
# Obtain from: Firebase Console -> Project Settings -> General -> Your apps -> Web app
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# -----------------------------------------------------------------------------
# LOCAL EMULATOR OVERRIDE (OPTIONAL)
# When set to 'true', the app connects to 127.0.0.1:8080 (Firestore) & 127.0.0.1:9099 (Auth).
# Leave commented out or 'false' for production builds.
# -----------------------------------------------------------------------------
# VITE_USE_FIREBASE_EMULATOR=true

# -----------------------------------------------------------------------------
# GOOGLE MAPS PLATFORM API KEY (OPTIONAL)
# If left blank, FoodLink safely uses the built-in offline interactive map fallback with zero API calls.
# -----------------------------------------------------------------------------
VITE_GOOGLE_MAPS_API_KEY=
